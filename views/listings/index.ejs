<% layout('layouts/boilerplate') %>

    <body>
        <h1>Wanderlust</h1>
        <p>Welcome to the Wanderlust!</p>
        <!-- <form action="/listings/new" method="GET">
        <button>new</button>
    </form> -->
        <!-- This is just a temporary button to test the route, we will replace it with a link in the navbar later -->


        <div class="row row-cols-lg-3 row-cols-md-3 row-cols-sm-2 row-cols-1 g-4">
            <% for (const listing of allListings) { %>
                <a href="/listings/<%= listing._id %>" class="listing-link">
                    <div class="card col">
                        <img src="<%= listing.image.url %>" class="card-img-top" alt="listing image"
                            style="height: 20rem;">
                            <!-- card overlay image -->
                            <div class="card-img-overlay">Ram </div>
                        <div class="card-body">
                            <p class="card-text"><strong>
                                    <%= listing.title %>
                                </strong> <br>₹<%= listing.price.toLocaleString("en-IN") %>/night</p>
                        </div>
                    </div>
                </a>
                <% } %>
        </div>
    </body>