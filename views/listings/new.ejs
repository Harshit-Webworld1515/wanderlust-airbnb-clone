<% layout('layouts/boilerplate') %>

    <body>
        <br>
        <div class="row">
            <div class="col-10 offset-1 col-md-8 offset-md-3">
                <h1>New Location</h1>
                <form action="/listings" method="POST" novalidate class="needs-validation"
                    enctype="multipart/form-data">
                    <div>
                        <label for="title" class="form-label">Enter title</label>
                        <input type="text" name="listing[title]" id="title" class="form-control" required><br>
                        <div class="valid-feedback">
                            Looks good!
                        </div>
                    </div>
                    <div>
                        <label for="description" class="form-label">Enter description</label>
                        <input type="text" name="listing[description]" id="description" class="form-control"
                            required><br>
                        <div class="invalid-feedback">
                            Enter a short description
                        </div>
                    </div>
                    <div>
                        <label for="url" class="form-label">Upload listing image</label>
                        <input type="file" name="listing[image][url]" id="url" class="form-control" required><br>
                    </div>
                    <div class="row">
                        <div class="col-md-4">
                            <label for="price" class="form-label">Enter price</label>
                            <input name="listing[price]" id="price" class="form-control" required><br>
                            <div class="invalid-feedback">
                                Please enter a valid price!
                            </div>
                        </div>
                        <div class="col-md-8">
                            <label for="country" class="form-label">Enter country</label>
                            <input type="text" name="listing[country]" id="country" class="form-control" required><br>
                            <div class="invalid-feedback">
                                Please enter a valid Country!
                            </div>
                        </div>
                        <div class="col-md-8">
                            <label for="category" class="form-label">Enter category</label>
                            <input type="text" name="listing[category]" id="category" class="form-control" required><br>
                            <div class="invalid-feedback">
                                Please enter a valid Category!
                            </div>
                        </div>
                    </div>
                    <div>
                        <label for="location" class="form-label">Enter location</label>
                        <input type="text" name="listing[location]" id="location" class="form-control" required><br>
                        <div class="invalid-feedback">
                            Location field is empty!
                        </div>
                    </div>
                    <button type="submit" class="btn btn-dark add-btn">Create Listing</button>
                </form>

            </div>
        </div>
        <br>
    </body>