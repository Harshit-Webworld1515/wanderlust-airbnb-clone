<% layout('layouts/boilerplate') %>

    <body>

        <div class="row mt-3">
            <div class="col-8 offset-3">
                <h1>Listing Details</h1>
            </div>
            <div class="card col-6 offset-3 show-card">
                <img src="<%= foundListing.image.url %>" class="card-img-top show-img" alt="<%= foundListing.title %>">
                <div class="card-body">
                    <h5 class="card-title">
                        <%= foundListing.title %>
                    </h5>
                    <p class="card-text">
                        <%= foundListing.description %> <br>
                            <%= foundListing.price.toLocaleString("en-IN") %>/night <br>
                                <%= foundListing.location %>,<br>
                                    <%= foundListing.country %>
                    </p>
                    <a href="#" class="btn btn-primary">Go somewhere</a>
                </div>
            </div>

            <div class="btns mb-3">
                <a class="btn btn-dark offset-3" href="/listings/<%= foundListing._id %>/edit">Edit</a>
                <form action="/listings/<%= foundListing._id %>?_method=DELETE" method="POST">
                    <button class="btn btn-dark offset-5">Delete</button>
                </form>
            </div>
        </div>


    </body>
